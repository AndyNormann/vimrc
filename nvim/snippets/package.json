{
  "name": "friendly-snippets",
  "engines": {
    "vscode": "^1.11.0"
  },
  "contributes": {
    "snippets": [
      {
        "language": "c",
        "path": "./c/c.json"
      },
      {
        "language": "cdoc",
        "path": "./c/cdoc.json"
      },
      {
        "language": "cpp",
        "path": "./cpp/cpp.json"
      },
      {
        "language": [
          "typescript",
          "typescriptreact",
          "javascript",
          "javascriptreact"
        ],
        "path": "./typescript.json"
      },
      {
        "language": "make",
        "path": "./make.json"
      }
    ]
  }
}
