{
  "console.log": {
    "prefix": "cl",
    "body": "console.log($1)"
  },
  "logger.log": {
    "prefix": "log",
    "body": "logger.log(`\\${PREFIX\\} $1`)"
  },
  "useState": {
    "prefix": "us",
    "body": [
      "const [${1:state}, set${1/(.*)/${1:/capitalize}/}] = useState($2)"
    ]
  },
  "useEffect": {
    "prefix": "eu",
    "body": [
      "useEffect(() => {",
      "  ${1:setup}",
      "",
      "}, [$2])",
      ""
    ]
  },
  "translation": {
    "prefix": "t",
    "body": "t(\"$1\")"
  }
}
